{
  "name": "pdfxlate",
  "version": "0.2.0",
  "description": "Layout-preserving PDF translation with any OpenAI-compatible model",
  "main": "out/main/main.js",
  "author": "jk-uzi",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jk-uzi/pdfxlate.git"
  },
  "homepage": "https://github.com/jk-uzi/pdfxlate#readme",
  "bugs": {
    "url": "https://github.com/jk-uzi/pdfxlate/issues"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "build": "npm run clean && npm run build:main && npm run build:renderer && npm run copy:static",
    "copy:static": "node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "make:icon": "node scripts/make-icon.mjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {}
}
