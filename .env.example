# Environment variables recognised by pdfxlate.
#
# This file is committed; it lists names only and must never contain values.
# Copy it to `.env` (gitignored) and fill in your own, or export the variables
# in your shell.
#
#   cp .env.example .env
#
# None of these are required to run the app: every setting also has a
# corresponding field in config.yaml.

# --- Where things are stored ---------------------------------------------

# Override the config directory (where config.yaml lives). The desktop app
# sets this to its per-user data directory automatically; set it only when
# driving the CLI with a non-default location.
PDFXLATE_CONFIG_DIR=

# HuggingFace endpoint used to download the layout model. Set this to a mirror
# where huggingface.co is unreachable; the downloader also tries
# https://hf-mirror.com on its own as a fallback.
HF_ENDPOINT=

# --- OCR ------------------------------------------------------------------

# Directory holding Tesseract *.traineddata files. Leave unset to have the
# required language data downloaded and cached automatically.
# Equivalent config field: ocr.tessdata_prefix
TESSDATA_PREFIX=

# --- Model credentials ----------------------------------------------------
#
# Referenced from config.yaml as ${VAR}, for example:
#
#   profiles:
#     deepseek:
#       api_key: ${DEEPSEEK_API_KEY}
#
# Any name works: the config loader expands ${ANY_VAR} from the environment.
# The names below are the conventional ones for the providers most people use.
# An unset variable expands to empty and is reported as "not configured".

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
